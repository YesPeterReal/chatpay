apiVersion: v1
kind: Secret
metadata:
  name: chatpay-secrets
type: Opaque
data:
  postgres-password: eW91ci1wb3N0Z3Jlcy1wYXNzd29yZA==
  stripe-secret-key: c2tfdGVzdF8xMjM=
  jwt-secret: eW91ci1qd3Qtc2VjcmV0
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: chatpay-ledger
spec:
  replicas: 2
  selector:
    matchLabels:
      app: chatpay-ledger
  template:
    metadata:
      labels:
        app: chatpay-ledger
    spec:
      containers:
      - name: chatpay-ledger
        image: 370924439074.dkr.ecr.eu-west-3.amazonaws.com/chatpay-ledger:latest
        ports:
        - containerPort: 8080
        env:
        - name: POSTGRES_PASSWORD
          valueFrom:
            secretKeyRef:
              name: chatpay-secrets
              key: postgres-password
        - name: STRIPE_SECRET_KEY
          valueFrom:
            secretKeyRef:
              name: chatpay-secrets
              key: stripe-secret-key
        - name: JWT_SECRET
          valueFrom:
            secretKeyRef:
              name: chatpay-secrets
              key: jwt-secret
---
apiVersion: v1
kind: Service
metadata:
  name: chatpay-service
spec:
  selector:
    app: chatpay-ledger
  ports:
  - protocol: TCP
    port: 80
    targetPort: 8080
  type: LoadBalancer